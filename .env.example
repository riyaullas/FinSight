# Settings for docker-compose.yml. Create the real file with:  sh deploy/scripts/init-env.sh
# Never commit .env.

# Public address Caddy serves. "localhost" uses a local certificate; a domain gets a trusted one.
SITE_ADDRESS=localhost
# Hostname only (no scheme or port), used by the API's allowed-hosts check.
SITE_HOST=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Use letters and digits only (it is embedded in a database URL).
POSTGRES_PASSWORD=
# At least 48 random characters.
SECRET_KEY=
# Fernet key: 32 random bytes, URL-safe base64.
FIELD_ENCRYPTION_KEY=
