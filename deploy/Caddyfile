# Single public entry point: HTTPS termination and routing.
# SITE_ADDRESS=localhost uses Caddy's own local certificate authority (browsers warn until it is trusted).
# Set SITE_ADDRESS to a real domain name to get a publicly trusted certificate automatically.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
